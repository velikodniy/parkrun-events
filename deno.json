{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "unstable": ["cron", "kv"],
  "imports": {
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "graphql": "https://esm.sh/graphql@16.11.0?target=denonext",
    "graphql-yoga": "https://esm.sh/graphql-yoga@5.22.0?deps=graphql@16.11.0&target=denonext"
  },
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net --allow-read --allow-write src/main.ts",
    "test": "deno test --frozen",
    "build": "deno check --frozen src/main.ts",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "preflight": "deno fmt --check && deno lint && deno check --frozen src/main.ts && deno test --frozen"
  }
}
